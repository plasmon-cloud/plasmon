    by_name = {}
    for run in raw_runs:
        name = str(run.get("name") or "")
        old = by_name.get(name)
        if old is None or int(run.get("id") or 0) > int(old.get("id") or 0):
            by_name[name] = run
    rows = []
    states = {}
    for lane, aliases in R2_REQUIRED_CHECKS.items():
        run = next((by_name.get(alias) for alias in aliases if by_name.get(alias) is not None), None)
        if run is None:
            row = {"lane": lane, "name": aliases[0], "state": "missing", "bucket": "pending", "link": None}
        else:
            bucket = check_bucket(run)
            row = {
                "lane": lane,
                "name": str(run.get("name") or aliases[0]),
                "state": str(run.get("conclusion") or run.get("status") or "unknown").lower(),
                "bucket": bucket,
                "link": run.get("details_url") or run.get("html_url"),
                "check_run_id": run.get("id"),
                "started_at": run.get("started_at"),
                "completed_at": run.get("completed_at"),
            }
        rows.append(row)
        states[lane] = {k: row.get(k) for k in ("name", "state", "bucket", "link", "check_run_id", "completed_at")}
    return rows, states

def pages(path):
    out = []
    page = 1
    sep = "&" if "?" in path else "?"
    while True:
        rows = api(f"{path}{sep}per_page=100&page={page}")
        if not isinstance(rows, list):
            raise RuntimeError(f"expected list from {path}")
        out.extend(rows)
        if len(rows) < 100:
            return out
        page += 1

def gh_json(args):
    env = dict(os.environ); env["GH_TOKEN"] = TOKEN
    proc = subprocess.run(["gh", *args], text=True, capture_output=True, env=env)
    if proc.returncode != 0:
        return None
    try: return json.loads(proc.stdout) if proc.stdout.strip() else None
    except json.JSONDecodeError: return None

_reachability = {}
def commit_reachable(ancestor_sha, descendant_sha):
    if not ancestor_sha or not descendant_sha:
        return False
    key = (str(ancestor_sha), str(descendant_sha))
    if key in _reachability:
        return _reachability[key]
    if key[0] == key[1]:
        _reachability[key] = True
        return True
    comparison = api(f"/compare/{key[0]}...{key[1]}")
    merge_base = ((comparison.get("merge_base_commit") or {}).get("sha"))
    result = merge_base == key[0] or str(comparison.get("status") or "").lower() in {"ahead", "identical"}
    _reachability[key] = result
    return result

def labels_of(issue):
    return sorted({str(x.get("name") if isinstance(x, dict) else x) for x in issue.get("labels") or [] if x})

def assignees_of(issue):
    return sorted({str(x.get("login")) for x in issue.get("assignees") or [] if isinstance(x, dict) and x.get("login")})

def field_value(issue, name):
    for item in issue.get("issue_field_values") or []:
        if item.get("issue_field_name") == name:
            return (item.get("single_select_option") or {}).get("name")
    return None

def product(labels, area, title):
    if any(label.startswith("ci:") for label in labels): return False
    if str(title).startswith("[r2 CI]"): return False
    if area == "Testing" and ("needs-verification" in labels or "ci:flaky" in labels): return False
    return True

def mapped_issue(pr, lane_numbers):
    body = str(pr.get("body") or "")
    title = str(pr.get("title") or "")
    for pattern, source in (
        (r"(?im)^\s*Plasmon-Issue\s*:\s*#(\d+)\b", body),
        (r"(?i)\b(?:closes|fixes|resolves)\s+#(\d+)\b", body),
        (r"^#(\d+)\b", title),
    ):
        m = re.search(pattern, source)
        if m and int(m.group(1)) in lane_numbers:
            return int(m.group(1))
    return None

def declared_base_from_body(body):
    body = str(body or "")
    match = re.search(r"(?im)^\s*(?:Stack-Parent|Parent branch)\s*:\s*(.+?)\s*$", body)
    if not match:
        return None
    line = match.group(1)
    tick = re.search(r"`([^`]+)`", line)
    if tick:
        return tick.group(1)
    if TARGET in line:
        return TARGET
    branchish = re.search(r"(?:^|/\s*)([A-Za-z0-9._-]+/[A-Za-z0-9._/-]+)\s*$", line)
    return branchish.group(1) if branchish else None

