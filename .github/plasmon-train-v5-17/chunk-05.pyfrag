    if rec["head"]:
        head_records.setdefault(rec["head"], []).append(rec)
# Closed lane Issues are already complete and need no reachability work.
# For still-open Issues, direct TARGET merges are integrated by construction;
# only historical/stack merges require the more expensive reachability check.
integrated = set()
for rec in mapped:
    if not rec["merged_at"] or not by_num[rec["issue"]]["open"]:
        continue
    if rec.get("base") == TARGET:
        integrated.add(rec["number"])
        continue
    if commit_reachable(rec.get("merge_commit_sha"), target_sha):
        integrated.add(rec["number"])
carrier = {}
changed = True
while changed:
    changed = False
    for rec in mapped:
        if not rec["merged_at"] or rec["number"] in integrated: continue
        parents = head_records.get(rec["base"], [])
        if any(p["number"] in integrated for p in parents):
            integrated.add(rec["number"]); carrier.pop(rec["number"], None); changed = True; continue
        open_parent = next((p for p in parents if p["state"] == "open"), None)
        if open_parent and carrier.get(rec["number"]) != open_parent["number"]:
            carrier[rec["number"]] = open_parent["number"]; changed = True; continue
        inherited = next((carrier.get(p["number"]) for p in parents if carrier.get(p["number"]) is not None), None)
        if inherited is not None and carrier.get(rec["number"]) != inherited:
            carrier[rec["number"]] = inherited; changed = True

by_issue_history = {}
for rec in mapped: by_issue_history.setdefault(rec["issue"], []).append(rec)
for issue_num, history in by_issue_history.items():
    row = by_num[issue_num]
    integrated_recs = [r for r in history if r["number"] in integrated]
    if integrated_recs:
        winner = sorted(integrated_recs, key=lambda r: (r.get("created_at") or "", r["number"]))[-1]
        row["integrated_pr"] = winner["number"]; row["target_integrated"] = True; row["merged"] = True; row["completed"] = True
        row["integrated_branch"] = winner.get("head")
        row["carried_by_pr"] = None
    elif row["pr"] is None:
        carried = [r for r in history if carrier.get(r["number"]) is not None]
        if carried:
            winner = sorted(carried, key=lambda r: (r.get("created_at") or "", r["number"]))[-1]
            row["carried_by_pr"] = carrier[winner["number"]]; row["active"] = True

# Assignment is only the active no-PR coding lease. Existing/open Product
# PRs may be unassigned; they remain normal PR-service work.
recoveries = [r for r in rows if r["product"] and r["open"] and r["claimed"] and r["pr"] is None and r["carried_by_pr"] is None and not r["target_integrated"]]
if len(recoveries) > 1:
    raise RuntimeError("multiple assigned no-PR Product recoveries: " + ", ".join(f"#{r['issue']}" for r in recoveries))

captured = int(time.time())
observations = {}

for row in rows:
    pr_num = row.get("pr")
    if pr_num is None or not row.get("open") or not row.get("product"): continue
    detail = gh_json([
        "pr","view",str(pr_num),"--repo",REPO,
        "--json","mergeable,mergeStateStatus,isDraft,headRefOid,headRefName,baseRefName,body",
    ]) or {}
    head = detail.get("headRefOid")
    actual_base = detail.get("baseRefName") or row.get("pr_base")
    base_head_sha = None
    compare_status = "unknown"
    ahead_by = behind_by = None
    merge_base_sha = None
    if actual_base and head:
        base_ref = api("/git/ref/heads/" + urllib.parse.quote(str(actual_base), safe=""))
        base_head_sha = ((base_ref.get("object") or {}).get("sha"))
        if base_head_sha:
            comparison = api(f"/compare/{base_head_sha}...{head}")
            compare_status = str(comparison.get("status") or "unknown").lower()
            ahead_by = int(comparison.get("ahead_by") or 0)
            behind_by = int(comparison.get("behind_by") or 0)
            merge_base_sha = ((comparison.get("merge_base_commit") or {}).get("sha"))
    checks, required_check_states = exact_head_required_checks(head)
    passed = running = failed = 0
    for check in checks:
        bucket = str(check.get("bucket") or "pending").lower()
        if bucket in {"pass", "success", "skipping", "skipped"}: passed += 1
        elif bucket in {"pending", "queued", "running", "in_progress", "in-progress"}: running += 1
        else: failed += 1

    flake_summary = next((check for check in checks if check.get("lane") == "flake_summary"), None)
    required_flake_summary_missing = flake_summary is None or str(flake_summary.get("state") or "").lower() == "missing"
    if required_flake_summary_missing:
        flake_probe_state = "missing"
    else:
        bucket = str(flake_summary.get("bucket") or "pending").lower()
        if bucket in {"skipping", "skipped"}: flake_probe_state = "skipped"
        elif bucket in {"pass", "success"}: flake_probe_state = "success"
        elif bucket in {"pending", "queued", "running", "in_progress", "in-progress"}: flake_probe_state = "running"
        else: flake_probe_state = "failed"

    required_failures = []
    for check in checks:
        bucket = str(check.get("bucket") or "pending").lower()
        if bucket not in {"pass","success","skipping","skipped","pending","queued","running","in_progress","in-progress"}:
            required_failures.append({
                key: check.get(key)
                for key in ("lane", "name", "state", "bucket", "link", "check_run_id")
                if check.get(key) is not None
            })
    diagnostic_evidence = {"required_check_states": required_check_states}
    if required_failures:
        diagnostic_evidence["required_failures"] = required_failures[:10]
    if flake_probe_state == "failed" and flake_summary is not None:
        flake_evidence = flake_summary_evidence(head, flake_summary)
