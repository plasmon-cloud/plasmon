{
  "name": "neutron-review",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts && npm run mogen",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "mopack": "bun ../../packages/neutron-scripts/src/mopack.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "validate": "bun ../../packages/neutron-scripts/src/validate.ts",
    "package": "npm run validate && npm run build && npm run mopack && npm run schema && bun ../../packages/neutron-scripts/src/pack.ts",
    "test:semantic": "bun test test",
    "test": "npm run package && npm run test:semantic",
    "attest:installed": "bun e2e/attest-installed.ts",
    "test:e2e": "npm run attest:installed && playwright test -c playwright.config.ts",
    "watch": "bun build.ts watch",
    "test:e2e:list": "playwright test -c playwright.config.ts --list"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "neutron-provision": "^0.1.0",
    "neutron-scripts": "^1.1.0"
  },
  "main": "dist/index.js",
  "packages": {},
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "Standalone structured collaborative Review Atoms for Neutron"
}
